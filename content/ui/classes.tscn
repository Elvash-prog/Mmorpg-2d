text = "Guerreiro · 140 vida / 80 energia

1. Corte · 0 EN · 0.7s
Golpe no alvo próximo.

2. Redemoinho · 18 EN · 4.0s
Atinge todos os inimigos ao redor.

3. Investida · 20 EN · 6.0s
Avança até o alvo; obstáculos bloqueiam o avanço.

4. Muralha · 20 EN · 9.0s
Absorve 50 de dano por até 5 s.

5. Fôlego · 25 EN · 12.0s
Recupera 48 de vida.

"
autowrap_mode = 3

